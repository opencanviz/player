{
  "name": "@opencanviz/player",
  "version": "0.1.0",
  "description": "Play openCanviz animated explainers on a canvas, or with a <canviz-player> element.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
