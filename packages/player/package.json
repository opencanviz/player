    "./assets/*": "./dist/assets/*"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "keywords": ["opencanviz", "animation", "diagram", "explainer", "canvas", "player", "web-component"],
  "homepage": "https://opencanviz.com",
  "dependencies": {
    "roughjs": "^4.6.6"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  }
