{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["dom", "dom.iterable", "es2021"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "../..",
    "outDir": "dist/types",
    "baseUrl": "../..",
    "paths": { "@/*": ["src/*"] }
  },
  "files": ["src/index.ts", "src/element.ts", "src/globals.d.ts"]
}
